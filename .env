# Local dev: DATABASE_URL is intentionally UNSET so the PGlite dev fallback boots
# (in-process Postgres, persisted to ./db/pglite). No external DB needed for the demo.

# Production (Vercel + Neon): set this to your Neon connection string.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/leadmachine?sslmode=require
