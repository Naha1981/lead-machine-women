// Lead Machine — Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  orgs         Organization[] @relation("OwnedOrgs")
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  industry            String
  services            String?
  logoUrl             String?
  primaryColor        String   @default("#059669")
  whatsappNumber      String?
  whatsappConnected   Boolean  @default(false)
  ownerPhone          String?
  plan                String   @default("trial") // trial | starter | growth | agency
  trialEndsAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  ownerId             String
  owner               User     @relation("OwnedOrgs", fields: [ownerId], references: [id])
  memberships         Membership[]
  leads               Lead[]
  websites            Website[]
  whatsappMessages    WhatsAppMessage[]
  subscription        Subscription?
}

model Membership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      String   @default("owner") // owner | admin | member
  createdAt DateTime @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model Lead {
  id             String   @id @default(cuid())
  orgId          String
  name           String
  phone          String
  email          String?
  serviceNeeded  String?
  message        String?
  source         String   @default("website")
  aiScore        Int?     // 1-10
  aiTemperature  String?  // hot | warm | cold
  aiReason       String?
  status         String   @default("new") // new | contacted | qualified | won | lost
  whatsappSent   Boolean  @default(false)
  ownerNotified  Boolean  @default(false)
  consentGiven   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  whatsappMessages WhatsAppMessage[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, aiTemperature])
}

model Website {
  id           String   @id @default(cuid())
  orgId        String   @unique
  template     String   @default("professional") // professional | legal | wellness | construction
  heroHeadline String?
  heroSubtext  String?
  aboutText    String?
  services     String?  // JSON: [{name, description}]
  faq          String?  // JSON: [{question, answer}]
  ctaText      String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  orgId       String
  leadId      String?
  direction   String   // inbound | outbound
  phoneNumber String
  content     String
  messageType String   @default("text")
  status      String   @default("sent") // pending | sent | delivered | read | failed
  createdAt   DateTime @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([leadId])
}

model Subscription {
  id              String   @id @default(cuid())
  orgId           String   @unique
  plan            String   @default("starter")
  amountZar       Int      @default(499900) // cents
  status          String   @default("trial") // trial | active | past_due | cancelled
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt       DateTime?
  createdAt        DateTime @default(now())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
