# Lead Machine — environment variables.
#
# Phase 1 (data layer): only DATABASE_URL matters.
#
# LOCAL DEV (this sandbox / your laptop):
#   Leave DATABASE_URL UNSET. The app boots an in-process Postgres (PGlite)
#   persisted to ./db/pglite — no external DB required. This is a dev-only
#   convenience; the schema is identical to production.
#
# PRODUCTION (Vercel + Neon):
#   Set DATABASE_URL to your Neon connection string, e.g.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/leadmachine?sslmode=require

# DATABASE_URL=

# --- LATER PHASES (documented here for awareness, not used in Phase 1) ---
# Phase 2 (Clerk auth) — REQUIRED for auth to work:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Phase 4 (Vercel AI SDK → Groq) — REQUIRED for AI features (website gen, lead qualification, chat):
# Groq is FREE (no credit card). Get a key at https://console.groq.com → API Keys.
GROQ_API_KEY=
# Optional: override the default model. Default: openai/gpt-oss-120b (fast, capable, free).
# Alternatives: llama-3.3-70b-versatile, llama-3.1-8b-instant
# AI_MODEL=openai/gpt-oss-120b
#
# ALTERNATIVE: paid OpenAI (uncomment + set OPENAI_API_KEY + remove baseURL in provider.ts):
# OPENAI_API_KEY=

# Phase 5 (Evolution API — real outbound WhatsApp):
EVOLUTION_API_URL=
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Safety switch: true = log-only (default, safe); false = send real WhatsApp via Evolution
SIMULATE_WHATSAPP=true

# Phase 6 (PayFast — billing):
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
