# Lead Machine — environment variables.
#
# LOCAL DEV:
#   Leave DATABASE_URL unset to use the PGlite development fallback.
# PRODUCTION:
#   Set DATABASE_URL to your Neon/Postgres connection string.

DATABASE_URL=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI (Groq, OpenAI-compatible)
GROQ_API_KEY=
# Default: openai/gpt-oss-120b
AI_MODEL=openai/gpt-oss-120b

# WhatsApp / Evolution API
EVOLUTION_API_URL=
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE_NAME=
SIMULATE_WHATSAPP=true

# Billing / PayFast
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=

# Revenue Leak Fix Builder — GitHub App
# Create a GitHub App with repository Contents: write, Pull requests: write,
# Actions: read, Metadata: read. The client installs it only on the selected repo.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_STATE_SECRET=
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Legacy/internal-only token fallback. Client repositories must use the GitHub App flow.
GITHUB_BUILDER_TOKEN=
