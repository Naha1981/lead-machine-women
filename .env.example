# Lead Machine — environment variables.
#
# LOCAL DEV:
#   Leave DATABASE_URL unset to use the PGlite development fallback.
# PRODUCTION:
#   Set DATABASE_URL to your Neon/Postgres connection string.

DATABASE_URL=

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# AI (Groq, OpenAI-compatible)
GROQ_API_KEY=
# Default: openai/gpt-oss-120b
AI_MODEL=openai/gpt-oss-120b

# WhatsApp / Evolution API
EVOLUTION_API_URL=
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_INSTANCE_NAME=
SIMULATE_WHATSAPP=true

# Billing / PayFast
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=

# Revenue Leak Fix Builder
# Server-side GitHub credential used only after the client has explicitly authorised
# the repository and the builder verifies access. Do not expose this to the browser.
GITHUB_BUILDER_TOKEN=
